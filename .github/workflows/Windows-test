name: Windows x86 (32-bit)

on:
  workflow_dispatch:
    inputs:
      source_ref:
        description: Branch, tag, or commit to build
        required: true
        type: string
        default: main
  push:
    tags:
      - "windows-x86-*"

permissions:
  contents: write

env:
  BUN_VERSION: "1.3.10"

jobs:
  windows-x86:
    name: Build Windows 32-bit x86
    runs-on: windows-latest
    timeout-minutes: 60

    steps:
      - name: Checkout source
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event_name == 'workflow_dispatch' && inputs.source_ref || github.ref }}

      - name: Set up Bun
        uses: oven-sh/setup-bun@v2
        with:
          bun-version: ${{ env.BUN_VERSION }}

      - name: Set up Rust x86 target
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: i686-pc-windows-msvc

      - name: Build web engine
        working-directory: redalert2
        shell: pwsh
        run: |
          bun install --frozen-lockfile
          bun run build

      - name: Compile Windows x86
        working-directory: redalert2
        shell: pwsh
        run: |
          bun run tauri:build -- --target i686-pc-windows-msvc --no-bundle

      - name: Package executable
        shell: pwsh
        run: |
          $ErrorActionPreference = "Stop"

          $exe = Get-ChildItem redalert2 -Recurse -File -Filter *.exe |
            Where-Object {
              $_.FullName -match 'target\\i686-pc-windows-msvc\\release\\[^\\]+\.exe$'
            } |
            Select-Object -First 1

          if (-not $exe) {
            Get-ChildItem redalert2 -Recurse -File -Filter *.exe |
              Select-Object -ExpandProperty FullName
            throw "Windows x86 executable not found."
          }

          New-Item -ItemType Directory -Force out | Out-Null

          Copy-Item $exe.FullName `
            out/RedAlert2-Engine-Windows-x86.exe

          @"
          Red Alert 2 Engine - Windows x86 (32-bit)

          Game files are not included.
          Import your own legally obtained game files.
          "@ | Set-Content out/README.txt

          Compress-Archive `
            -Path out/RedAlert2-Engine-Windows-x86.exe,out/README.txt `
            -DestinationPath out/RedAlert2-Engine-Windows-x86.zip `
            -Force

          Get-FileHash out/RedAlert2-Engine-Windows-x86.zip -Algorithm SHA256

      - name: Upload build artifact
        uses: actions/upload-artifact@v4
        with:
          name: windows-x86
          path: out/RedAlert2-Engine-Windows-x86.zip
          if-no-files-found: error
          retention-days: 30

      - name: Publish GitHub Release
        shell: pwsh
        env:
          GH_TOKEN: ${{ github.token }}
          EVENT_NAME: ${{ github.event_name }}
          REF_NAME: ${{ github.ref_name }}
          RUN_NUMBER: ${{ github.run_number }}
        run: |
          $ErrorActionPreference = "Stop"

          if ($env:EVENT_NAME -eq "push" -and
              $env:REF_NAME -like "windows-x86-*") {
            $tag = $env:REF_NAME
          } else {
            $tag = "windows-x86-build-$env:RUN_NUMBER"
          }

          gh release create $tag `
            out/RedAlert2-Engine-Windows-x86.zip `
            --repo $env:GITHUB_REPOSITORY `
            --target (git rev-parse HEAD) `
            --prerelease `
            --title "Windows x86 build $env:RUN_NUMBER" `
            --notes "Experimental 32-bit Windows build. Game files are not included."
