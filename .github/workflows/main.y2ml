name: Windows 7 SP1 x86 Compatibility Build

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build Windows 7 SP1 32-bit application
    runs-on: windows-latest
    timeout-minutes: 120

    env:
      RUST_TARGET: i686-win7-windows-msvc
      RUSTUP_TOOLCHAIN: nightly

    steps:
      # 1. Download the repository
      - name: Checkout repository
        uses: actions/checkout@v4

      # 2. Install Bun
      - name: Set up Bun
        uses: oven-sh/setup-bun@v2
        with:
          bun-version: "1.3.10"

      # 3. Install nightly Rust and its source code
      - name: Set up Nightly Rust
        uses: dtolnay/rust-toolchain@nightly
        with:
          components: rust-src

      # 4. Verify the target exists in the Rust compiler
      - name: Check Rust toolchain
        shell: pwsh
        run: |
          $ErrorActionPreference = "Stop"

          Write-Host "========== Rust version =========="
          rustc --version
          cargo --version

          Write-Host "========== Checking Windows 7 target =========="

          $targets = rustc --print target-list

          if ($targets -notcontains $env:RUST_TARGET) {
            throw "The Rust compiler does not recognize target $env:RUST_TARGET"
          }

          Write-Host "Target recognized: $env:RUST_TARGET"

          Write-Host "========== Installed Rust components =========="
          rustup component list --installed

      # 5. Install frontend dependencies
      - name: Install frontend dependencies
        working-directory: redalert2
        shell: pwsh
        run: |
          $ErrorActionPreference = "Stop"

          bun install --frozen-lockfile

      # 6. Build the frontend
      - name: Build frontend
        working-directory: redalert2
        shell: pwsh
        run: |
          $ErrorActionPreference = "Stop"

          bun run build

      # 7. Configure Cargo to build the Windows 7 standard library
      - name: Configure Cargo
        working-directory: redalert2/src-tauri
        shell: pwsh
        run: |
          $ErrorActionPreference = "Stop"

          New-Item -ItemType Directory -Force ".cargo" |
            Out-Null

          @'
          [unstable]
          build-std = ["std", "panic_unwind"]
          '@ | Set-Content `
              -Path ".cargo/config.toml" `
              -Encoding utf8

          Write-Host "========== Cargo configuration =========="
          Get-Content ".cargo/config.toml"

      # 8. Build the application directly through Cargo
      # This bypasses Tauri CLI's target validation.
      - name: Build Windows 7 x86 application
        working-directory: redalert2/src-tauri
        shell: pwsh
        run: |
          $ErrorActionPreference = "Stop"

          Write-Host "========== Building application =========="
          Write-Host "Target: $env:RUST_TARGET"
          Write-Host "Toolchain: $env:RUSTUP_TOOLCHAIN"

          cargo build `
            --locked `
            --release `
            --target $env:RUST_TARGET

          if ($LASTEXITCODE -ne 0) {
            throw "Cargo build failed with exit code $LASTEXITCODE"
          }

      # 9. Collect the executable and related files
      - name: Collect build output
        shell: pwsh
        run: |
          $ErrorActionPreference = "Stop"

          $releaseDir = "redalert2/src-tauri/target/$env:RUST_TARGET/release"
          $outDir = "out"

          Write-Host "========== Locating output =========="

          if (!(Test-Path $releaseDir)) {
            throw "Release directory not found: $releaseDir"
          }

          $exes = @(
            Get-ChildItem -Path $releaseDir -Filter "*.exe" -File
          )

          if ($exes.Count -eq 0) {
            throw "No executable was produced in $releaseDir"
          }

          New-Item -ItemType Directory -Force $outDir |
            Out-Null

          # Copy executables and any DLL/PDB files in the release root.
          $files = Get-ChildItem -Path $releaseDir -File |
            Where-Object {
              $_.Extension -in @(".exe", ".dll", ".pdb")
            }

          foreach ($file in $files) {
            Copy-Item $file.FullName $outDir -Force
          }

          Write-Host "========== Executables =========="

          Get-ChildItem -Path $outDir -Filter "*.exe" -File |
            Select-Object Name, Length

          Write-Host "========== Collected files =========="

          Get-ChildItem -Path $outDir -File |
            Select-Object Name, Length

      # 10. Upload the generated files
      - name: Upload build artifact
        uses: actions/upload-artifact@v4
        with:
          name: RedAlert2-Windows7-SP1-x86
          path: out/
          if-no-files-found: error
          retention-days: 14
